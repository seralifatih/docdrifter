{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docdrifter-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "docdrifter-db",
      "database_id": "d1fd42f5-8fbb-4e9a-a814-599280a764b4"
    }
  ],
  "ratelimits": [
    // Native platform rate limiting, no D1 round-trip. Simple counting
    // algorithm: at most `limit` requests per `period` seconds, per key
    // (we pass the caller's IP as the key at call time). One binding is
    // reused across /waitlist, /checkout, and /status since they're all
    // "low-frequency human actions," not something that legitimately
    // needs a different threshold from each other.
    { "name": "PUBLIC_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    // Non-secret config. PADDLE_CLIENT_TOKEN is client-exposed by design
    // (it's embedded in the checkout page's Paddle.js call), so it lives
    // here too rather than as a Worker secret. PADDLE_WEBHOOK_SECRET is
    // set via `wrangler secret put`, not here.
    "CHECKOUT_BASE_URL": "https://docdrifter.com",

    // --- SANDBOX (temporary, for testing the checkout flow) ---
    // To go back to live billing: set PADDLE_ENV to "production" (or drop
    // it), swap the two PADDLE_PRICE_ID / PADDLE_CLIENT_TOKEN lines below,
    // and re-put the production PADDLE_API_KEY + PADDLE_WEBHOOK_SECRET
    // secrets, since sandbox and production credentials aren't
    // interchangeable.
    "PADDLE_ENV": "sandbox",
    "PADDLE_PRICE_ID": "pri_01m1226zbz5m77hbbzk2nb0nhj",
    "PADDLE_CLIENT_TOKEN": "test_a4c460d7bcf98f4df054aa1d953",
    // Production values, restore when sandbox testing is done:
    //   "PADDLE_PRICE_ID": "pri_01m0zv1fn8rsj6xhgjxydxavqd",
    //   "PADDLE_CLIENT_TOKEN": "live_1b3d2879563153f1ce6576b5189",

    "PRICE_AMOUNT": "$9",
    "PRICE_UNIT": "per repo / month\nbilled for every private repo on this installation",
    "GITHUB_APP_CLIENT_ID": "Iv23ctoP6jHaTcYmqEjC"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    // Once a day: prune expired sessions and old request logs. Neither
    // table had any retention before this -- both grew forever.
    "crons": ["17 3 * * *"]
  }
}
